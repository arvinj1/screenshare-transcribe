+  border-left: 3px solid var(--accent);
+}
+
+.slide-card-pre {
+  border-left-color: var(--text-secondary);
+}
+
+.slide-card-live {
+  border-left-color: var(--warning);
+  opacity: 0.7;
+}
+
+.slide-card-header {
+  margin-bottom: 0.5rem;
+}
+
+.slide-card-label {
+  font-size: 0.75rem;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  color: var(--text-secondary);
+}
+
+.slide-card-ocr {
+  font-size: 0.875rem;
+  line-height: 1.5;
+  white-space: pre-wrap;
+  word-break: break-word;
+  margin-bottom: 0.5rem;
+}
+
+.slide-card-audio {
+  border-top: 1px solid var(--border);
+  padding-top: 0.5rem;
+  margin-top: 0.25rem;
+}
+
+.slide-card-audio-heading {
+  font-size: 0.7rem;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  color: var(--text-secondary);
+  margin-bottom: 0.375rem;
+}
+
+.slide-card-audio-line {
+  display: flex;
+  align-items: baseline;
+  gap: 0.5rem;
+  margin-bottom: 0.25rem;
+  font-size: 0.8125rem;
+  line-height: 1.5;
+}
+
+.slide-card-audio-text {
+  color: var(--text-secondary);
+}
+
+/* Audio badges */
+.audio-badge {
+  font-size: 0.625rem;
