+}
+
+.insight-point {
+  border-left: 3px solid var(--success);
+}
+
+.insight-action {
+  border-left: 3px solid var(--warning);
+}
+
+/* ===== Summary Timeline ===== */
+.summary-timeline {
+  display: flex;
+  flex-direction: column;
+  gap: 0.75rem;
+}
+
+.summary-timeline-card {
+  background-color: var(--bg-tertiary);
+  border-radius: 8px;
+  overflow: hidden;
+}
+
+.summary-timeline-card-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 0.625rem 0.75rem;
+  border-bottom: 1px solid var(--border);
+}
+
+.summary-timeline-audio {
+  display: flex;
+  align-items: baseline;
+  gap: 0.5rem;
+  padding: 0.5rem 0.75rem;
+  font-size: 0.8125rem;
+  color: var(--text-secondary);
+  line-height: 1.5;
+  border-top: 1px solid var(--border);
+}
+
+/* ===== Raw Data Section ===== */
+.raw-data-section {
+  border-top: 1px solid var(--border);
+  padding-top: 1rem;
+}
+
+.raw-data-toggle {
+  background: none;
+  border: 1px solid var(--border);
+  color: var(--text-secondary);
+  font-size: 0.8125rem;
+  padding: 0.375rem 0.75rem;
+  border-radius: 6px;
+  cursor: pointer;
+  transition: background-color 0.2s;
+}
+
+.raw-data-toggle:hover {
+  background-color: var(--bg-tertiary);
+}
+
+.raw-data-content {
+  margin-top: 1rem;
+}
+
+.raw-data-block {
+  margin-bottom: 1rem;
+}
+
+.raw-data-block h4 {
+  font-size: 0.8125rem;
+  font-weight: 600;
+  color: var(--text-secondary);
+  margin-bottom: 0.5rem;
+}
+
+/* ===== Export Buttons ===== */
+.summary-header-actions {
+  display: flex;
+  align-items: center;
+  gap: 0.5rem;
+}
+
+.btn-export {
+  background-color: var(--accent);
+  color: white;
+}
+
+.btn-export:hover {
+  background-color: var(--accent-hover);
+}
+
+.btn-copy {
+  background-color: var(--bg-tertiary);
+  color: var(--text-primary);
+  border: 1px solid var(--border);
+}
+
+.btn-copy:hover {
+  background-color: var(--border);
+}
